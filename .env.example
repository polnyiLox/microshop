# Copy this file to .env and replace every placeholder before starting Compose.
# The real .env file is ignored by Git.
MICROSHOP_DB_PASSWORD=change-this-postgres-password
MONGODB_PASSWORD=change-this-mongodb-password
RABBITMQ_PASSWORD=change-this-rabbitmq-password
REDIS_PASSWORD=change-this-redis-password
MINIO_PASSWORD=change-this-minio-password
INTERNAL_API_TOKEN=change-this-long-internal-api-token
GRAFANA_PASSWORD=change-this-grafana-password

FRONTEND_PORT=3000
GATEWAY_PORT=8080
FRONTEND_API_URL=http://localhost:8080/v1
FRONTEND_SITE_URL=http://localhost:3000
