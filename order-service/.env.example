APP_CONFIG__DB__USER=postgres
APP_CONFIG__DB__PASSWORD=change_me
APP_CONFIG__DB__HOST=postgres
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__NAME=order_service_db

APP_CONFIG__API__V1_PREFIX=/v1
APP_CONFIG__API__HOST=0.0.0.0
APP_CONFIG__API__PORT=8002
APP_CONFIG__API__RELOAD=false

APP_CONFIG__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:9092
APP_CONFIG__KAFKA__CLIENT_ID=order-service
APP_CONFIG__KAFKA__ACKS=all
APP_CONFIG__ANALYTICS_TOPICS__ORDER_EVENTS_TOPIC=order.analytics.events

APP_CONFIG__CATALOG_CLIENT__BASE_URL=http://host.docker.internal:8001/v1

APP_CONFIG__RABBITMQ__USER=microservices
APP_CONFIG__RABBITMQ__PASSWORD=change_me
APP_CONFIG__RABBITMQ__HOST=host.docker.internal
APP_CONFIG__RABBITMQ__PORT=5672
APP_CONFIG__RABBITMQ__VHOST=/

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=order_service_db

APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
APP_CONFIG__REDIS__PASSWORD=change_me
APP_CONFIG__REDIS__TTL_SECONDS=60
APP_CONFIG__REDIS__KEY_PREFIX=order
APP_CONFIG__REDIS__USER_ORDERS_KEY=user:
APP_CONFIG__REDIS__SELLER_ORDERS_KEY=seller:
APP_CONFIG__REDIS__ORDER_ITEMS_KEY=:items:
