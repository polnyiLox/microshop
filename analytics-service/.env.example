APP_CONFIG__REDIS__TTL_SECONDS=60
APP_CONFIG__REDIS__KEY_PREFIX=analytics
APP_CONFIG__REDIS__OVERVIEW_KEY=overview


MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_INITDB_DATABASE=start_app
