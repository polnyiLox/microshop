APP_CONFIG__KAFKA__GROUP_ID=analytics-service
APP_CONFIG__KAFKA__AUTO_OFFSET_RESET=earliest
APP_CONFIG__KAFKA__ENABLE_AUTO_COMMIT=false
APP_CONFIG__ANALYTICS_TOPICS__ORDER_EVENTS_TOPIC=order.analytics.events
APP_CONFIG__ANALYTICS_TOPICS__PAYMENT_EVENTS_TOPIC=payment.analytics.events

APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
